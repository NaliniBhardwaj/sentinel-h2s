# Defaults to a local SQLite file so the backend runs with zero setup.
# For production, point this at PostgreSQL, e.g.:
#   postgresql+psycopg2://sentinel:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel_dev.db

# Generate a real secret for anything beyond local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

ENV=development
CORS_ORIGINS=*

# ML camera analysis (LAB ΔE + regression on POST /scans/from-image)
ML_ENABLED=true
ML_MODEL_PATH=model.pkl
ML_DELTA_E_MAX=47.28
