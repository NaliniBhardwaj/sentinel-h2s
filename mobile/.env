# Base URL of the FastAPI backend (native: emulator / Expo Go on phone).
# Android emulator -> http://10.0.2.2:8000
# Physical phone on same Wi-Fi -> http://192.168.1.14:8000  (use your PC's ipconfig IPv4)
EXPO_PUBLIC_API_URL=http://192.168.1.14:8000
# Web browser (auto-used when Platform.OS === 'web')
EXPO_PUBLIC_API_URL_WEB=http://localhost:8000
EXPO_PUBLIC_ML_ENABLED=true
# Upload captures to POST /scans/from-image when online (LAB ML on server)
